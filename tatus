[32m+[m[32m   ▼[m
[32m+[m[32mValidation[m
[32m+[m[32m   │[m
[32m+[m[32m   ▼[m
[32m+[m[32mNormalization[m
[32m+[m[32m   │[m
[32m+[m[32m   ▼[m
[32m+[m[32mEnrichment[m
[32m+[m[32m   │[m
[32m+[m[32m   ├───────────────┐[m
[32m+[m[32m   ▼               ▼[m
[32m+[m[32mRule Engine      ML Engine[m
[32m+[m[32m   │               │[m
[32m+[m[32m   └───────┬───────┘[m
[32m+[m[32m           ▼[m
[32m+[m[32m      Correlation[m
