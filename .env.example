# SENTINEL-X development environment
# Copy this file to .env and replace development secrets before use.

# General
APP_NAME=SENTINEL-X
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-development-secret-key-minimum-16-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinelx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinelx

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ML
ML_MODEL_DIR=/app/ml_artifacts

# Simulator
BACKEND_URL=http://backend:8000
SIM_USERNAME=simulator
SIM_PASSWORD=change-this-development-password
SIM_MODE=mixed
SIM_RATE_EVENTS=2.0
SIM_BATCH_SIZE=10
SIM_DURATION_SEC=0
SIM_LOG_LEVEL=INFO
